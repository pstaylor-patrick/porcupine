# Copy to ~/.config/porcupine/.env (or set PORCUPINE_ENV_FILE) and chmod 600.
# Never commit the real file.

# The URL you open the app at. WebSocket connections from any other origin are
# refused. Comma-separate several if you reach the hub by more than one name.
PORCUPINE_ORIGIN=https://porcupine.example.com

# The password you type on the login page.
PORCUPINE_RPC_PASSWORD=

# Signs the login cookie. Generate with: openssl rand -hex 32
PORCUPINE_COOKIE_SECRET=

# Optional: model provider key passed to pi. The default model is
# vercel-ai-gateway anthropic/claude-opus-5.5 with low thinking; pass other pi flags after
# `porcupine --` to use another provider, e.g. `porcupine -- --provider anthropic --model ...`.
VERCEL_AI_GATEWAY_API_KEY=
