# Copy to ~/.config/porcupine/.env (or set PORCUPINE_ENV_FILE) and chmod 600.
# Never commit the real file.

# The URL you open the app at. WebSocket connections from any other origin are
# refused. Comma-separate several if you reach the hub by more than one name.
PORCUPINE_ORIGIN=https://porcupine.example.com

# The password you type on the login page.
PORCUPINE_RPC_PASSWORD=

# Signs the login cookie. Generate with: openssl rand -hex 32
PORCUPINE_COOKIE_SECRET=

# Model provider keys passed to pi. OPENROUTER_API_KEY is required. The optional
# ANTHROPIC_API_KEY and OPENAI_API_KEY serve those vendors' models direct; while
# one is empty, that vendor's models come from OpenRouter. The default model is
# Claude Opus 5.5 with low thinking. Pass other pi flags after `porcupine --`.
OPENROUTER_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# Override the default model for new sessions (vendor/model, e.g. zai/glm-5).
# PORCUPINE_MODEL=
